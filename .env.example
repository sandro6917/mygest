# =============================================================================
# CONFIGURAZIONE MYGEST - Environment Variables
# =============================================================================
# ISTRUZIONI:
# 1. Copia questo file in .env:  cp .env.example .env
# 2. Genera SECRET_KEY sicura:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Personalizza i valori per il tuo ambiente
# 4. NON committare .env su git (è in .gitignore)

# =============================================================================
# DJANGO CORE - ⚠️ OBBLIGATORIO PER PRODUZIONE
# =============================================================================

# Ambiente di esecuzione: development | production
# - development: DEBUG=True, CORS permissivo, email console, logs verbosi
# - production: DEBUG=False forzato, HTTPS enforced, security hardened
DJANGO_ENV=development

# DEBUG mode (NON usare True in produzione!)
# In production settings, questo è sempre forzato a False
DEBUG=True

# SECRET_KEY - ⚠️ OBBLIGATORIO E DEVE ESSERE SICURO
# ❌ NON lasciare il default! Genera chiave con comando sopra
# ✅ Minimo 50 caratteri, mai committare su git
# Produzione: SECRET_KEY deve essere impostato, nessun fallback
SECRET_KEY=

# ALLOWED_HOSTS - Domini abilitati (separati da virgola)
# Development: localhost,127.0.0.1,100.99.234.12
# Production: mygest.example.com,api.mygest.example.com (NO wildcard!)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE
# =============================================================================

# Opzione 1: DATABASE_URL (raccomandato, ha priorità)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://mygest_user:SecurePassword123@localhost:5432/mygest

# Opzione 2: Parametri singoli (fallback se DATABASE_URL non presente)
DB_NAME=mygest
DB_USER=mygest_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Database connection pooling (default: enabled, disabilita solo per debug)
# DISABLE_DB_POOL=False

# =============================================================================
# REDIS CACHE
# =============================================================================

# Redis principale (cache, celery, etc)
REDIS_URL=redis://127.0.0.1:6379/1

# Redis per sessioni (opzionale, default usa stesso Redis db diverso)
# REDIS_SESSION_URL=redis://127.0.0.1:6379/2

# =============================================================================
# ARCHIVIO / STORAGE
# =============================================================================

# Percorso base per archiviazione documenti
# Development: ./archivio (locale progetto) o /mnt/archivio (NAS montato)
# Production: /srv/mygest/archivio (NAS montato su VPS)
# ⚠️ Il percorso DEVE esistere e essere scrivibile dall'utente mygest
ARCHIVIO_BASE_PATH=/mnt/archivio

# Directories sorgente per importazioni massive (separati da virgola)
# IMPORTAZIONI_SOURCE_DIRS=/home/user/importazioni,/mnt/nas/documenti

# =============================================================================
# EMAIL SMTP (invio)
# =============================================================================

# Backend email (default: smtp, alternative: console per sviluppo)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Configurazione SMTP
EMAIL_HOST=smtps.aruba.it
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mygest.local
EMAIL_TIMEOUT=30

# Failover a console se SMTP fallisce (solo development)
# EMAIL_FAILOVER_TO_CONSOLE=true

# =============================================================================
# EMAIL IMAP (ricezione per archiviazione comunicazioni)
# =============================================================================

EMAIL_IMAP_HOST=imaps.aruba.it
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_SENT_FOLDER=Inviati
# EMAIL_IMAP_SENT_FOLDERS=Sent,Inviati,Posta inviata (multipli separati da virgola)
EMAIL_IMAP_TIMEOUT=60

# =============================================================================
# WHATSAPP BUSINESS CLOUD API
# =============================================================================

# Meta WhatsApp Business Platform credentials
# Documentazione: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_CLOUD_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_TIMEOUT=10

# =============================================================================
# GOOGLE CALENDAR INTEGRATION
# =============================================================================

# Path file credenziali OAuth2 Google
GOOGLE_CALENDAR_CREDENTIALS_FILE=/path/to/google_credentials.json

# Calendar ID default per sync scadenze
GOOGLE_CALENDAR_DEFAULT_ID=

# =============================================================================
# AI CLASSIFIER / OPENAI
# =============================================================================

# OpenAI API key per classificazione documenti
# Ottieni da: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# STAMPE / ETICHETTE
# =============================================================================

# Nome stampante DYMO per etichette
DYMO_PRINTER_NAME=DYMO_LabelWriter_450

# Abilita stampa server-side (vs client-side)
# ETICHETTE_SERVER_PRINT=false

# Margine etichette in millimetri
# ETICHETTE_MARGIN_MM=10.0

# =============================================================================
# ARCHIVIO FISICO
# =============================================================================

# ID unità fisica per documenti scartati/cestinati
# ARCHIVIO_FISICO_UNITA_SCARICO_ID=28

# =============================================================================
# DOCUMENTI
# =============================================================================

# Pattern naming file documenti (template)
# Variabili: {tipo.codice}, {id}, {attr:campo|default}, {data_documento:%Y%m%d}, {slug:campo}
# DOCUMENTI_FILE_PATTERN_DEFAULT={tipo.codice}_{id}_{attr:repertorio_atto|REPNA}_{data_documento:%Y%m%d}_{slug:descrizione}.pdf

# Rename solo documenti nuovi (non già rinominati)
# DOCUMENTI_RENAME_ONLY_NEW=true

# Lunghezza massima nome file
# DOCUMENTI_FILENAME_MAX_LEN=140

# Abilita suffix univoco se nome duplicato
# DOCUMENTI_PATTERN_ENABLE_UNIQUE=true

# =============================================================================
# LOGGING
# =============================================================================

# Log SQL queries in console (solo development, molto verboso)
# LOG_SQL=false

# =============================================================================
# PRODUCTION SECURITY (opzionali, defaults sensibili già configurati)
# =============================================================================

# Force HTTPS redirect (già abilitato in production settings)
# SECURE_SSL_REDIRECT=true

# HSTS max age (default: 1 anno in production)
# SECURE_HSTS_SECONDS=31536000

