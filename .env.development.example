# =============================================================================
# MYGEST DEVELOPMENT - Quick Start Configuration
# =============================================================================
# Questo è un template pre-compilato per sviluppo locale.
# 
# SETUP RAPIDO:
# 1. cp .env.development.example .env
# 2. Modifica SECRET_KEY con chiave generata (comando sotto)
# 3. Personalizza DB_PASSWORD se necessario
# 4. python manage.py migrate
# 5. python manage.py runserver
#
# GENERA SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Development mode
DJANGO_ENV=development
DEBUG=True

# ⚠️ SOSTITUISCI CON CHIAVE GENERATA (comando sopra)
SECRET_KEY=REPLACE-WITH-GENERATED-SECRET-KEY-MINIMUM-50-CHARACTERS

# Development hosts
ALLOWED_HOSTS=localhost,127.0.0.1,100.99.234.12

# =============================================================================
# DATABASE (locale)
# =============================================================================

# Opzione 1: URL completo (raccomandato)
DATABASE_URL=postgresql://mygest_user:ScegliUnaPasswordSicura@localhost:5432/mygest

# Opzione 2: Parametri singoli (se preferisci)
# DB_NAME=mygest
# DB_USER=mygest_user
# DB_PASSWORD=ScegliUnaPasswordSicura
# DB_HOST=127.0.0.1
# DB_PORT=5432

# =============================================================================
# REDIS (locale)
# =============================================================================

REDIS_URL=redis://127.0.0.1:6379/1
REDIS_SESSION_URL=redis://127.0.0.1:6379/2

# =============================================================================
# ARCHIVIO (locale)
# =============================================================================

# Development: archivio locale nel progetto
ARCHIVIO_BASE_PATH=./archivio

# Oppure usa NAS montato (se disponibile)
# ARCHIVIO_BASE_PATH=/mnt/archivio

# =============================================================================
# EMAIL (development usa console backend automaticamente)
# =============================================================================

# Se vuoi testare SMTP reale, decomment e configura:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=your_email@gmail.com

# Altrimenti, email vanno in console (default development)

# =============================================================================
# INTEGRATIONS (opzionali)
# =============================================================================

# OpenAI API per AI Classifier (opzionale in dev)
# OPENAI_API_KEY=sk-...

# WhatsApp (opzionale in dev)
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_ACCESS_TOKEN=

# Google Calendar (opzionale in dev)
# GOOGLE_CALENDAR_CREDENTIALS_FILE=./google_credentials.json
# GOOGLE_CALENDAR_DEFAULT_ID=

# =============================================================================
# LOGGING (opzionale)
# =============================================================================

# Log SQL queries in console (molto verboso, solo per debugging)
# LOG_SQL=true
