[Unit]
Description=MyGest Celery Beat Scheduler
After=network.target redis.service postgresql.service celery-worker.service
Requires=redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/mygest/app
EnvironmentFile=/srv/mygest/app/.env
ExecStart=/srv/mygest/venv/bin/celery -A mygest beat --loglevel=info
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
UMask=0002

StandardOutput=append:/srv/mygest/logs/celery-beat.log
StandardError=append:/srv/mygest/logs/celery-beat.log

[Install]
WantedBy=multi-user.target
