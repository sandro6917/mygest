[Unit]
Description=MyGest Celery Worker
After=network.target redis.service postgresql.service
Requires=redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/mygest/app
EnvironmentFile=/srv/mygest/app/.env
ExecStart=/srv/mygest/venv/bin/celery -A mygest worker --loglevel=info --concurrency=2
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=60

StandardOutput=append:/srv/mygest/logs/celery-worker.log
StandardError=append:/srv/mygest/logs/celery-worker.log

[Install]
WantedBy=multi-user.target
